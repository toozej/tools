# Copy this file to app.env Set these values for server-side defaults.
# Form values override these defaults for each request.
# Readeck configuration
READECK_URL=https://readeck.example.com
READECK_API_TOKEN=your-readeck-api-token

# Use an OpenAI Chat Completions or Anthropic Messages endpoint.
# LLM API configuration
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o
LLM_API_TOKEN=your-llm-api-token
